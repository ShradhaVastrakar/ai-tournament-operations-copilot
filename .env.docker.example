# Upload this (with real values) to Jenkins as a "Secret file" credential:
#   ID: AI_TOURNAMENT_COPILOT_ENV
# Jenkins copies it as .env next to docker-compose.yml and uses it for the web build arg.

# Host ports on the server
WEB_HOST_PORT=4010
API_HOST_PORT=4011

# URL the BROWSER uses to reach the Express API (baked into the Next.js build)
NEXT_PUBLIC_API_BASE_URL=http://<server-ip-or-domain>:4011

# URL the browser opens the frontend on (CORS on Express; exact match, no trailing slash)
FRONTEND_ORIGIN=http://<server-ip-or-domain>:4010

# AI service
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
AGENT_MAX_STEPS=12
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

BODY_LIMIT=1mb
