# AI Service environment — copy to .env and fill in values.
# The AI service will start and serve placeholder responses without these set.

HOST=0.0.0.0
PORT=8000

# LLM provider configuration (optional until LLM integration is implemented)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-key-here

# LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=ai-tournament-copilot
