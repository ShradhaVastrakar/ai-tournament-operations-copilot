# AI Service environment — copy to .env and fill in values.
# Without GROQ_API_KEY the service starts, but /internal/ai/answer returns a 502.

HOST=0.0.0.0
PORT=8000

# Groq LLM — required for real answers. Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Model served via Groq (default shown below)
# LLM_MODEL=llama-3.1-8b-instant

# Max graph steps per question (each model call or tool call is one step)
# AGENT_MAX_STEPS=12

# RAG vector store (local Chroma, relative to apps/ai-service/)
# VECTOR_DB_DIR=chroma_db
# RAG_TOP_K=5
# RAG_MAX_DISTANCE=0.75

# LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=ai-tournament-copilot
